# syntax=docker/dockerfile:1
#
# Native build of the dojjail-based intercepting-communication challenges.
# Mirrors OLD intro-to-cybersecurity-dojo/intercepting-communication/Dockerfile
# (python:3.13-slim + dojjail + scapy), with the workspace tools the levels and
# their solvers use (script/nc/ip/iptables/tcpdump/sysctl) and the uid-1000
# "hacker" account the pwnshop test harness execs as. No prebuilt legacy image.
#
# The per-level challenge ships only its `run` script; everything else is shared.

FROM python:3.13-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        bash \
        bsdextrautils \
        iproute2 \
        iptables \
        iputils-ping \
        netcat-openbsd \
        nmap \
        procps \
        tcpdump \
        util-linux && \
    rm -rf /var/lib/apt/lists/* && \
    update-alternatives --set iptables /usr/sbin/iptables-legacy && \
    update-alternatives --set ip6tables /usr/sbin/ip6tables-legacy

# Inside dojjail's namespaces the shell runs as a (mapped) root whose unprivileged
# "tcpdump" uid is unmapped, so tcpdump's default privilege-drop fails with EINVAL.
# Wrap it to stay root (-Z root), matching the legacy workspace where capture "just works".
RUN real="$(command -v tcpdump)" && mv "$real" "$real.real" && \
    printf '#!/bin/sh\nexec "%s.real" -Z root "$@"\n' "$real" > "$real" && \
    chmod 755 "$real"

ADD --chown=0:0 --chmod=6755 http://github.com/pwncollege/exec-suid/releases/latest/download/exec-suid /usr/bin/exec-suid

RUN pip install --no-cache-dir \
        flask \
        psutil \
        requests \
        https://github.com/pwncollege/dojjail/archive/refs/heads/master.zip \
        https://github.com/secdev/scapy/archive/refs/heads/master.zip

# The pwnshop test harness execs as uid 1000.
RUN echo "hacker:x:1000:1000::/home/hacker:/bin/bash" >> /etc/passwd && \
    echo "hacker:x:1000:" >> /etc/group && \
    mkdir -p /home/hacker && chown 1000:1000 /home/hacker

# dojjail's interactive() spawns $SHELL (default /bin/sh = dash, which drops the
# pre-fed commands some solvers write); the pwn.college workspace uses bash.
ENV SHELL=/bin/bash

COPY . /challenge
RUN rm -f /challenge/Dockerfile

# Startup: SUID the run script and provide the iptables lock (mirrors OLD .init,
# which the legacy engine ran at container start; pwnshop runs /challenge/.init).
COPY --chmod=755 <<'EOF' /challenge/.init
#!/bin/bash
chmod 6755 /challenge/run
touch /run/xtables.lock
rm -f /challenge/.init
EOF
