#!/usr/bin/exec-suid -- /usr/bin/python3 -I
# Secure Chat v2: the "members board" appends every message to a secret members
# notice (which contains the flag) and shows you the AES-ECB ciphertext. ECB
# encrypts equal plaintext blocks to equal ciphertext blocks, so a chosen-prefix
# attacker can peel the secret out one byte at a time.
import os
import sys

from Crypto.Cipher import AES
from Crypto.Util.Padding import pad

key = os.urandom(16)
secret = b"members-only notice -- vault code is " + open("/flag").read().strip().encode()

print("=== Secure Chat v2 (members board) ===")
print("post a message (hex) with:  e <hex>     quit with:  q")
sys.stdout.flush()

for line in sys.stdin:
    line = line.strip()
    if line[:1] == "q":
        break
    if line[:1] == "e":
        try:
            msg = bytes.fromhex(line[1:].strip())
        except ValueError:
            print("bad hex")
            sys.stdout.flush()
            continue
        ct = AES.new(key, AES.MODE_ECB).encrypt(pad(msg + secret, 16))
        print("cipher (hex):", ct.hex())
    sys.stdout.flush()
