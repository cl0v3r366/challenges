#!/usr/bin/exec-suid -- /usr/bin/python3 -I
# Secure Chat v1: the session transcript (which quotes the flag) is XOR-encrypted
# with a fresh random keystream. A debugging command leaks the keystream -- and a
# stream cipher whose keystream is exposed offers no secrecy at all.
import os
import sys

flag = open("/flag").read().strip()
transcript = ("[admin] heads up team, the new vault code is " + flag).encode()
keystream = os.urandom(len(transcript))
ciphertext = bytes(a ^ b for a, b in zip(transcript, keystream))

print("=== Secure Chat v1 ===")
print("Replaying the encrypted transcript for this session.")
print("transcript (hex):", ciphertext.hex())
print()
print("commands:  r = replay-keystream (debug),  q = quit")
sys.stdout.flush()

for line in sys.stdin:
    cmd = line.strip().lower()[:1]
    if cmd == "r":
        print("DEBUG keystream (hex):", keystream.hex())
    elif cmd == "q":
        break
    else:
        print("unknown command")
    sys.stdout.flush()
