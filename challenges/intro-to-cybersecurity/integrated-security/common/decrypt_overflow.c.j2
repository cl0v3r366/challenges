{#- Faithful transcription of OLD pwncollege_modules/toddlerzero/decrypt_overflow.c,
    with base/base.c's win()/disable_aslr/main() inlined (print_greeting=False,
    constant_goodbye=False, vbuf_in_main=True, win_variable=False).  `challenge.X`
    -> `c.X`; the leaf builds `c` then {% include %}s this file.

    The binary decrypts an attacker-supplied AES-128-ECB ciphertext into a fixed
    `struct { header[8]; length; message[N]; }`; the message decrypt overflows the
    N-byte buffer (N is seed-derived).  win-variant has win(); shellcode-variant
    has an executable stack and disabled ASLR instead. -#}
#define _GNU_SOURCE 1

