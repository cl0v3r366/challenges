#!/usr/bin/env python3
# Functionality smoke test for the toy pwnserver (integrated-security web-overflow*).
# Start /challenge/server, wait for it to listen on port 80, then make a NORMAL
# GET for a served file and assert the expected body + Server banner.  This proves
# the server serves files without performing the overflow or revealing the flag.
import atexit
import socket
import subprocess
import time

PORT = 80


def http_get(path, timeout=2):
    """Send a raw HTTP/1.1 GET (the server only parses the request line) and
    return the full response bytes."""
    with socket.create_connection(("127.0.0.1", PORT), timeout=timeout) as s:
        s.sendall(f"GET {path} HTTP/1.1\n\n".encode())
        s.settimeout(timeout)
        chunks = []
        while True:
            try:
                buf = s.recv(4096)
            except OSError:
                # The server closes abruptly after responding (RST on follow-up
                # recv); treat that, and timeouts, as end-of-response.
                break
            if not buf:
                break
            chunks.append(buf)
        return b"".join(chunks)


proc = subprocess.Popen(["/challenge/server"])
atexit.register(proc.kill)

# Wait for the server by retrying a REAL GET. Do NOT poll with bare connect()s that
# close without reading: the server double-writes its response and does not ignore
# SIGPIPE, so writing to a peer that connected-and-closed would kill it.
response = None
deadline = time.time() + 15
while time.time() < deadline:
    try:
        candidate = http_get("index.txt")
    except OSError:
        time.sleep(0.1)
        continue
    if b"HTTP/1.1" in candidate:
        response = candidate
        break
    time.sleep(0.1)
assert response, "server did not respond to GET index.txt in time"
assert b"200 OK" in response, "expected 200 OK for index.txt, got: %r" % response[:200]
assert b"Server: pwnserver/" in response, "missing pwnserver Server header: %r" % response[:200]
assert b"Welcome to the pwnserver" in response, "missing index.txt body: %r" % response

# The second served file should come back too.
manifesto = http_get("hacker_manifesto.txt")
assert b"the medium is the message" in manifesto, "missing hacker_manifesto body: %r" % manifesto

# Requesting a missing file must be rejected, not crash the server.
missing = http_get("does_not_exist.txt")
assert b"404" in missing, "expected 404 for a missing file, got: %r" % missing[:200]

# This is a PUBLIC test: it must never reveal the flag on the benign path.
for blob in (response, manifesto, missing):
    assert b"pwn.college{" not in blob, "flag leaked on a benign request"

print("Web server functionality tests passed")
