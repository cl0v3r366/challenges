{#- Secure-chat pwn levels (integrated-security capstone, written from scratch).
    level 3: nickname overflow flips an adjacent is_admin flag -> admin_console().
    level 4: message overflow overwrites the saved return address -> admin_console().
    level 5: message overflow + executable stack + disabled ASLR -> shellcode.
    The leaf sets c.level / c.nick_size / c.msg_size / c.win_function / c.disable_aslr,
    then {% include %}s this file. -#}
#define _GNU_SOURCE 1

#include <stdlib.h>
#include <stdint.h>
#include <stdio.h>
#include <unistd.h>
#include <fcntl.h>
#include <string.h>
#include <errno.h>
#include <assert.h>
#include <sys/prctl.h>
#include <sys/personality.h>

{% if c.disable_aslr %}
void __attribute__((constructor)) disable_aslr(int argc, char **argv, char **envp)
{
    int current_personality = personality(0xffffffff);
    assert(current_personality != -1);
    if ((current_personality & ADDR_NO_RANDOMIZE) == 0) {
        assert(personality(current_personality | ADDR_NO_RANDOMIZE) != -1);
        assert(prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != -1);
        execve("/proc/self/exe", argv, envp);
    }
}
{% endif %}

{% if c.win_function %}
void admin_console()
{
    static char flag[256];
    static int flag_fd;
    static int flag_length;

    puts("Opening the admin console -- here is the members board:");
    flag_fd = open("/flag", 0);
    if (flag_fd < 0) {
        printf("\n  ERROR: Failed to open the flag -- %s!\n", strerror(errno));
        if (geteuid() != 0) {
            printf("  Your effective user id is not 0!\n");
            printf("  You must directly run the suid binary in order to have the correct permissions!\n");
        }
        exit(-1);
    }
    flag_length = read(flag_fd, flag, sizeof(flag));
    if (flag_length <= 0) {
        printf("\n  ERROR: Failed to read the flag -- %s!\n", strerror(errno));
        exit(-1);
    }
    write(1, flag, flag_length);
    printf("\n\n");
}
{% endif %}

{% if c.level == 3 %}
int main(int argc, char **argv, char **envp)
{
    setvbuf(stdin, NULL, _IONBF, 0);
    setvbuf(stdout, NULL, _IONBF, 0);

    struct {
        char nick[{{ c.nick_size }}];
        int is_admin;
    } user = {0};

    puts("=== Secure Chat v3 ===");
    puts("Register your nickname (the members board is for admins only):");
    read(0, &user, sizeof(user));

    if (user.is_admin) {
        puts("Welcome back, admin!");
        admin_console();
    } else {
        puts("Welcome, guest. Sorry, the members board is admins-only.");
    }
}
{% else %}
void chat()
{
    char message[{{ c.msg_size }}];

    puts("Compose your message:");
    read(0, message, 0x200);
    puts("Your message has been queued for delivery.");
}

int main(int argc, char **argv, char **envp)
{
    setvbuf(stdin, NULL, _IONBF, 0);
    setvbuf(stdout, NULL, _IONBF, 0);

    puts("=== Secure Chat v{{ c.level }} ===");
    chat();
}
{% endif %}
