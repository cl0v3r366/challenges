{%- extends "../../../common/Dockerfile.j2" -%}
{%- block additional_packages %}{{ super() }} python3-pycryptodome{% endblock -%}
{%- block before_copy %}
RUN python3 -c "import Cryptodome, os; d = os.path.dirname(Cryptodome.__file__); os.symlink(d, os.path.join(os.path.dirname(d), 'Crypto'))"
{% endblock -%}
{%- block setup %}
RUN <<'EOF'
set -eu
chmod 4755 /challenge/chat
rm -f /challenge/Dockerfile /challenge/.setup
EOF
{% endblock -%}
