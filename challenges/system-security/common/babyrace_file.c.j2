#define _GNU_SOURCE
#include <assert.h>
#include <errno.h>
#include <fcntl.h>
#include <libgen.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

{% if c.win_function %}
static void win(void)
{
    char flag[256];
    int flag_fd = open("/flag", O_RDONLY);
    if (flag_fd < 0) {
        printf("\n  ERROR: Failed to open the flag -- %s!\n", strerror(errno));
        exit(1);
    }
    int flag_length = read(flag_fd, flag, sizeof(flag));
    if (flag_length <= 0) {
        printf("\n  ERROR: Failed to read the flag -- %s!\n", strerror(errno));
        exit(1);
    }
    write(1, flag, flag_length);
    printf("\n\n");
}
{% endif %}

{% if c.stack_smash %}
static void __attribute__((noinline)) vulnerable_read(const char *path)
{
    char read_buffer[{{ c.read_buffer_size }}];
    read(open(path, O_RDONLY), read_buffer, {{ c.read_size }});
}
{% endif %}

static void pause_if_walkthrough(void)
{
    {% if c.walkthrough %}
    puts("Paused (press enter to continue)");
    getchar();
    {% endif %}
}

int main(int argc, char **argv)
{
    setvbuf(stdin, NULL, _IONBF, 0);
    setvbuf(stdout, NULL, _IONBF, 0);

    struct stat stat_data;
    {% if c.read or c.sendfile %}
    {% if c.win_variable %}
    struct {
        char read_buffer[{{ c.read_buffer_size }}];
        unsigned long long win_variable;
    } data;
    data.win_variable = 0;
    #define READ_BUFFER data.read_buffer
    {% else %}
    char read_buffer[{{ c.read_buffer_size }}];
    #define READ_BUFFER read_buffer
    {% endif %}
    {% endif %}

    assert(argc > 1);

    if (strstr(argv[1], "flag")) {
        puts("Error: path contains `flag`!");
        exit(1);
    }

    pause_if_walkthrough();

    if (lstat(argv[1], &stat_data) == -1) {
        puts("Error: failed to get file status!");
        exit(1);
    }

    if (S_ISLNK(stat_data.st_mode)) {
        puts("Error: file is a symlink!");
        exit(1);
    }

    {% if c.max_size %}
    if (stat_data.st_size > {{ c.max_size }}) {
        puts("Error: file is too large!");
        exit(1);
    }
    {% endif %}

    {% if c.check_directory_stat or c.check_directory_lstat %}
    pause_if_walkthrough();

    char *path_copy = strdup(argv[1]);
    assert(path_copy);
    {% if c.check_directory_stat %}
    if (stat(dirname(path_copy), &stat_data) == -1) {
    {% else %}
    if (lstat(dirname(path_copy), &stat_data) == -1) {
    {% endif %}
        puts("Error: failed to get directory status!");
        exit(1);
    }
    free(path_copy);

    if (stat_data.st_uid != 0) {
        puts("Error: directory not owned by root!");
        exit(1);
    }
    if (stat_data.st_gid != 0) {
        puts("Error: directory not group owned by root!");
        exit(1);
    }
    if (stat_data.st_mode & S_IWOTH) {
        puts("Error: other users are able to write in this directory!");
        exit(1);
    }
    {% endif %}

    {% if c.sleep %}
    usleep({{ c.sleep }});
    {% endif %}

    pause_if_walkthrough();

    {% if c.sendfile %}
    int fd = open(argv[1], O_RDONLY);
    int length = read(fd, READ_BUFFER, {{ c.read_buffer_size }});
    if (length > 0) {
        write(1, READ_BUFFER, length);
    }
    {% elif c.read %}
    {% if c.stack_smash %}
    vulnerable_read(argv[1]);
    {% else %}
    read(open(argv[1], O_RDONLY), READ_BUFFER, {{ c.read_size }});
    {% endif %}
    {% if c.win_variable %}
    if (data.win_variable) {
        win();
    }
    {% endif %}
    {% endif %}

    return 0;
}
