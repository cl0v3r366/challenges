  {%- set c.device_permissions = "0600" -%}
  {%- set c.device_write = true -%}
  {%- set c.shellcode_write = true -%}
  {%- set c.user_binary = true -%}
{%- endmacro -%}

{%- macro pwn_func_ptr(c, random, walkthrough=false) -%}
  {{- defaults(c, random, walkthrough) -}}
  {%- set c.solve = "pwn_func_ptr" -%}
