{%- endmacro -%}

{%- macro delete_flag_hang(c, random, walkthrough=false) -%}
  {{- defaults(c, random, walkthrough) -}}
  {%- set c.solve = "delete_flag_hang" -%}
  {%- set c.device_permissions = "0600" -%}
  {%- set c.device_write = true -%}
  {%- set c.shellcode_write = true -%}
  {%- set c.user_binary = true -%}
  {%- set c.user_load_flag = true -%}
  {%- set c.user_load_flag_hang = true -%}
  {%- set c.user_delete_flag = true -%}
{%- endmacro -%}

{%- macro delete_flag(c, random, walkthrough=false) -%}
  {{- defaults(c, random, walkthrough) -}}
  {%- set c.solve = "delete_flag" -%}
  {%- set c.device_permissions = "0600" -%}
  {%- set c.device_write = true -%}
  {%- set c.shellcode_write = true -%}
  {%- set c.user_binary = true -%}
  {%- set c.user_load_flag = true -%}
  {%- set c.user_load_flag_hang = false -%}
  {%- set c.user_delete_flag = true -%}
{%- endmacro -%}
