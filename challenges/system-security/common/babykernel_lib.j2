  {%- set c.kernel_log = true -%}
{%- endmacro -%}

{%- macro pwn_func_ptr_kaslr(c, random, walkthrough=false) -%}
  {{- pwn_func_ptr(c, random, walkthrough) -}}
  {%- set c.solve = "pwn_func_ptr_kaslr" -%}
