#!/bin/bash
set -euo pipefail

for file in /challenge/*; do
    [ -f "$file" ] || continue
    if file "$file" | grep -q 'ELF' && readelf -l "$file" | grep -q INTERP; then
        patchelf --set-interpreter /lib64/ld-linux-x86-64.so.2 "$file"
    fi
done

[ ! -f /challenge/libcapstone.so.5 ] || cp /challenge/libcapstone.so.5 /usr/lib/libcapstone.so.5
chown -R 0:0 /challenge
find /challenge -maxdepth 1 -type f -perm /111 -exec chmod 4755 {} +
