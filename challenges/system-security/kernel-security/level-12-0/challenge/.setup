#!/bin/bash
set -euo pipefail

build-kernel-module /challenge/babykernel_level12_0.c /challenge/babykernel_level12.0.ko
gcc -O0 -fno-pie -no-pie -o /challenge/babykernel_level12.0 /challenge/babykernel_level12_0_userspace.c -lseccomp -pthread
chmod 4755 /challenge/babykernel_level12.0
rm -f /challenge/babykernel_level12_0.c /challenge/babykernel_level12_0_userspace.c
